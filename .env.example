# Copy to .env (gitignored) and fill in real values. Never commit real tokens.
JIRA_BASE_URL=https://cloud-f1.atlassian.net
JIRA_EMAIL=you@cloud-f1.com
JIRA_API_TOKEN=

# Optional: project-specific custom field IDs (only needed for create_issue extras).
# Confirmed CF1 values as of 2026-06-04 — verify with detect_project_fields before trusting
# these on a different Jira project; field IDs are per-project, not global.
JIRA_FIELD_EPIC_LINK=customfield_10014
JIRA_FIELD_SPRINT=customfield_10020
JIRA_FIELD_STORY_POINTS=customfield_10031
