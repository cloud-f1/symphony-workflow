{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/session-start-check-api.sh\"",
            "timeout": 15,
            "statusMessage": "Checking symphony-workflow API server..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/commit-key-check.py\"",
            "timeout": 15,
            "statusMessage": "Checking the commit subject carries the ticket key..."
          }
        ]
      }
    ]
  }
}
